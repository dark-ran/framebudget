 void FrameSinkManagerImpl::Throttle(const std::vector<FrameSinkId>& ids,
@@ -1305,20 +1315,55 @@ void FrameSinkManagerImpl::StopThrottlingAllFrameSinks() {
   UpdateThrottling();
 }
 
+void FrameSinkManagerImpl::SetFrameBudgetInterval(
+    const FrameSinkId& frame_sink_id,
+    base::TimeDelta interval) {
+  if (interval.is_positive()) {
+    frame_budget_intervals_[frame_sink_id] = interval;
+  } else {
+    frame_budget_intervals_.erase(frame_sink_id);
+  }
+  UpdateThrottling();
+}
+
 void FrameSinkManagerImpl::ApplyThrottlingRules(
     const base::flat_set<FrameSinkId>& throttled_roots,
+    const base::flat_map<FrameSinkId, base::TimeDelta>& budget_roots,
     const base::flat_set<FrameSinkId>& captured_roots) {
   // Apply throttling
+  base::flat_set<FrameSinkId> throttled;
   if (ThrottleIntervalHasEffect()) {
     for (const auto& id : throttled_roots) {
-      RecurseChildren(id, [this](const FrameSinkId& frame_sink_id) {
+      RecurseChildren(id, [this, &throttled](const FrameSinkId& frame_sink_id) {
         if (auto* support = GetFrameSinkForId(frame_sink_id)) {
           support->SetThrottleInterval(throttle_interval_);
+          throttled.insert(frame_sink_id);
         }
       });
     }
   }
 
+  // FrameBudget: each frame sink gets the longest budget among the budget
+  // roots above it, and only if that is longer than the interval set so far.
+  base::flat_map<FrameSinkId, base::TimeDelta> budgets;
+  for (const auto& [root, interval] : budget_roots) {
+    RecurseChildren(root,
+                    [&budgets, interval](const FrameSinkId& frame_sink_id) {
+                      base::TimeDelta& budget = budgets[frame_sink_id];
+                      budget = std::max(budget, interval);
+                    });
+  }
+  const base::TimeDelta global_throttle =
+      global_throttle_interval_.value_or(base::TimeDelta());
+  for (const auto& [frame_sink_id, budget] : budgets) {
+    if (auto* support = GetFrameSinkForId(frame_sink_id)) {
+      const base::TimeDelta current = throttled.contains(frame_sink_id)
+                                          ? throttle_interval_
+                                          : global_throttle;
+      support->SetThrottleInterval(std::max(budget, current));
+    }
+  }
+
   // Do not allow throttling on frame sinks currently being captured.
   for (const auto& id : captured_roots) {
     RecurseChildren(id, [this](const FrameSinkId& frame_sink_id) {
@@ -1340,7 +1385,8 @@ void FrameSinkManagerImpl::UpdateThrottling() {
     support->SetAllowThrottling(true);
   }
 
-  ApplyThrottlingRules(frame_sink_ids_to_throttle_, captured_frame_sink_ids_);
+  ApplyThrottlingRules(frame_sink_ids_to_throttle_, frame_budget_intervals_,
+                       captured_frame_sink_ids_);
 }
 
 bool FrameSinkManagerImpl::ThrottleIntervalHasEffect() const {
