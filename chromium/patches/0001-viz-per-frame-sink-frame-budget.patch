 namespace content {
 
 // Signals the frame sink manager that all current and future frame sinks should
@@ -52,6 +56,19 @@ CONTENT_EXPORT void UpdateThrottlingFrameSinks(
     const std::set<GlobalRenderFrameHostId>& throttle_frames,
     base::TimeDelta interval);
 
+// FrameBudget: limits `frame_sink_id` and all its descendant sinks (e.g.
+// out-of-process iframes) to send BeginFrames at an interval at least as long
+// as `interval`. Each frame sink keeps its own limit, independently of the
+// functions above, so different tabs can run at different frame rates. The
+// limit never shortens an interval chosen by the functions above. A zero
+// `interval` removes the limit, and it is dropped automatically when the frame
+// sink goes away.
+//
+// Should be called from the UI thread.
+CONTENT_EXPORT void SetFrameBudgetForFrameSink(
+    const viz::FrameSinkId& frame_sink_id,
+    base::TimeDelta interval);
+
 }  // namespace content
 
 #endif  // CONTENT_PUBLIC_BROWSER_FRAME_RATE_THROTTLING_H_
