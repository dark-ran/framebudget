index 0000000000..ca257467cb
--- /dev/null
+++ b/chrome/browser/ui/framebudget/framebudget_tab_helper.h
@@ -0,0 +1,62 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_FRAMEBUDGET_FRAMEBUDGET_TAB_HELPER_H_
+#define CHROME_BROWSER_UI_FRAMEBUDGET_FRAMEBUDGET_TAB_HELPER_H_
+
+#include <optional>
+
+#include "base/time/time.h"
+#include "components/viz/common/surfaces/frame_sink_id.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+// FrameBudget: limits how often a tab's web content produces frames, while the
+// browser UI and the monitor keep their normal refresh rate.
+//
+// The limit of a tab comes from, in order of priority:
+//  1. A per-tab override, cycled with CycleTabOverride() (Alt+Shift+F).
+//  2. The first rule in --framebudget-sites matching the tab's host or one of
+//     its parent domains, e.g.
+//     --framebudget-sites=youtube.com=60,example.com=15
+//  3. --framebudget-default-fps. No limit when absent.
+// An FPS of 0 means no limit.
+class FrameBudgetTabHelper
+    : public content::WebContentsObserver,
+      public content::WebContentsUserData<FrameBudgetTabHelper> {
+ public:
+  FrameBudgetTabHelper(const FrameBudgetTabHelper&) = delete;
+  FrameBudgetTabHelper& operator=(const FrameBudgetTabHelper&) = delete;
+  ~FrameBudgetTabHelper() override;
+
+  // Steps the per-tab override: site rule -> 60 -> 30 -> 15 -> 5 -> no limit
+  // -> site rule. Returns the FPS now in effect (0 = no limit).
+  int CycleTabOverride();
+
+  // Returns the FPS in effect for this tab (0 = no limit).
+  int EffectiveFps() const;
+
+ private:
+  friend class content::WebContentsUserData<FrameBudgetTabHelper>;
+
+  explicit FrameBudgetTabHelper(content::WebContents* web_contents);
+
+  // content::WebContentsObserver:
+  void RenderFrameCreated(content::RenderFrameHost* render_frame_host) override;
+  void RenderFrameHostChanged(content::RenderFrameHost* old_host,
+                              content::RenderFrameHost* new_host) override;
+  void PrimaryPageChanged(content::Page& page) override;
+  void WebContentsDestroyed() override;
+
+  // Sends the tab's limit to viz when its frame sink or FPS has changed.
+  void Apply();
+
+  std::optional<int> tab_override_fps_;
+  viz::FrameSinkId applied_frame_sink_id_;
+  base::TimeDelta applied_interval_;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+#endif  // CHROME_BROWSER_UI_FRAMEBUDGET_FRAMEBUDGET_TAB_HELPER_H_
