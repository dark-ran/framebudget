diff --git a/chrome/browser/ui/framebudget/framebudget_tab_helper.cc b/chrome/browser/ui/framebudget/framebudget_tab_helper.cc
new file mode 100644
index 0000000000..0a029dd33e
--- /dev/null
+++ b/chrome/browser/ui/framebudget/framebudget_tab_helper.cc
@@ -0,0 +1,177 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/framebudget/framebudget_tab_helper.h"
+
+#include <array>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "base/command_line.h"
+#include "base/logging.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "content/public/browser/frame_rate_throttling.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/render_widget_host.h"
+#include "content/public/browser/web_contents.h"
+#include "url/gurl.h"
+
+namespace {
+
+constexpr char kDefaultFpsSwitch[] = "framebudget-default-fps";
+constexpr char kSitesSwitch[] = "framebudget-sites";
+
+// Steps of the per-tab override. Stepping past the last one returns the tab to
+// its site rule.
+constexpr std::array<int, 5> kOverrideSteps = {60, 30, 15, 5, 0};
+
+struct Config {
+  int default_fps = 0;
+  // (host, fps) in command line order.
+  std::vector<std::pair<std::string, int>> sites;
+};
+
+// Returns `value` as a positive FPS, or 0 (no limit) if it is not one.
+int ParseFps(std::string_view value) {
+  int fps = 0;
+  return base::StringToInt(value, &fps) && fps > 0 ? fps : 0;
+}
+
+Config ReadConfig() {
+  const base::CommandLine& command_line =
+      *base::CommandLine::ForCurrentProcess();
+  Config config;
+  config.default_fps =
+      ParseFps(command_line.GetSwitchValueASCII(kDefaultFpsSwitch));
+  const std::string sites = command_line.GetSwitchValueASCII(kSitesSwitch);
+  for (std::string_view rule :
+       base::SplitStringPiece(sites, ",", base::TRIM_WHITESPACE,
+                              base::SPLIT_WANT_NONEMPTY)) {
+    std::vector<std::string_view> parts = base::SplitStringPiece(
+        rule, "=", base::TRIM_WHITESPACE, base::SPLIT_WANT_ALL);
+    if (parts.size() != 2 || parts[0].empty()) {
+      LOG(WARNING) << "FrameBudget: ignoring malformed site rule: " << rule;
+      continue;
+    }
+    config.sites.emplace_back(base::ToLowerASCII(parts[0]),
+                              ParseFps(parts[1]));
+  }
+  return config;
+}
+
+const Config& GetConfig() {
+  static const base::NoDestructor<Config> config(ReadConfig());
+  return *config;
+}
+
+// Returns the FPS of the first site rule matching `host` or one of its parent
+// domains, or the default FPS.
+int FpsForHost(std::string_view host) {
+  const Config& config = GetConfig();
+  for (const auto& [site, fps] : config.sites) {
+    if (host == site || (host.ends_with(site) &&
+                         host[host.size() - site.size() - 1] == '.')) {
+      return fps;
+    }
+  }
+  return config.default_fps;
+}
+
+}  // namespace
+
+FrameBudgetTabHelper::FrameBudgetTabHelper(content::WebContents* web_contents)
+    : content::WebContentsObserver(web_contents),
+      content::WebContentsUserData<FrameBudgetTabHelper>(*web_contents) {
+  Apply();
+}
+
+FrameBudgetTabHelper::~FrameBudgetTabHelper() = default;
+
+int FrameBudgetTabHelper::CycleTabOverride() {
+  if (!tab_override_fps_) {
+    tab_override_fps_ = kOverrideSteps[0];
+  } else {
+    size_t i = 0;
+    while (i < kOverrideSteps.size() &&
+           kOverrideSteps[i] != *tab_override_fps_) {
+      ++i;
+    }
+    if (i + 1 < kOverrideSteps.size()) {
+      tab_override_fps_ = kOverrideSteps[i + 1];
+    } else {
+      tab_override_fps_.reset();
+    }
+  }
+  Apply();
+  return EffectiveFps();
+}
+
+int FrameBudgetTabHelper::EffectiveFps() const {
+  if (tab_override_fps_) {
+    return *tab_override_fps_;
+  }
+  return FpsForHost(web_contents()->GetLastCommittedURL().host());
+}
+
+void FrameBudgetTabHelper::RenderFrameCreated(
+    content::RenderFrameHost* render_frame_host) {
+  if (render_frame_host == web_contents()->GetPrimaryMainFrame()) {
+    Apply();
+  }
+}
+
+void FrameBudgetTabHelper::RenderFrameHostChanged(
+    content::RenderFrameHost* old_host,
+    content::RenderFrameHost* new_host) {
+  if (new_host && new_host->IsInPrimaryMainFrame()) {
+    Apply();
+  }
+}
+
+void FrameBudgetTabHelper::PrimaryPageChanged(content::Page& page) {
+  Apply();
+}
+
+void FrameBudgetTabHelper::WebContentsDestroyed() {
+  content::SetFrameBudgetForFrameSink(applied_frame_sink_id_,
+                                      base::TimeDelta());
+  applied_frame_sink_id_ = viz::FrameSinkId();
+}
+
+void FrameBudgetTabHelper::Apply() {
+  content::RenderWidgetHost* widget =
+      web_contents()->GetPrimaryMainFrame()->GetRenderWidgetHost();
+  const viz::FrameSinkId frame_sink_id =
+      widget ? widget->GetFrameSinkId() : viz::FrameSinkId();
+  const int fps = EffectiveFps();
+  const base::TimeDelta interval =
+      fps > 0 ? base::Hertz(fps) : base::TimeDelta();
+  if (frame_sink_id == applied_frame_sink_id_ &&
+      interval == applied_interval_) {
+    return;
+  }
+
+  // The main frame moved to a new widget (e.g. a cross-process navigation).
+  if (applied_frame_sink_id_.is_valid() &&
+      applied_frame_sink_id_ != frame_sink_id) {
+    content::SetFrameBudgetForFrameSink(applied_frame_sink_id_,
+                                        base::TimeDelta());
+  }
+  content::SetFrameBudgetForFrameSink(frame_sink_id, interval);
+  applied_frame_sink_id_ = frame_sink_id;
+  applied_interval_ = interval;
+
+  VLOG(1) << "FrameBudget: "
+          << web_contents()->GetLastCommittedURL().host() << " -> "
+          << (fps > 0 ? base::NumberToString(fps) + " fps" : "no limit")
+          << (tab_override_fps_ ? " (tab override)" : "") << ", frame sink "
+          << frame_sink_id.ToString();
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(FrameBudgetTabHelper);
