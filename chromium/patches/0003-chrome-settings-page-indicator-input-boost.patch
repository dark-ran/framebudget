+</section>
+
+<section>
+  <h2>사이트 규칙</h2>
+  <p class="note">하위 도메인에도 적용돼요. 더 구체적인 도메인 규칙이 우선이에요.</p>
+  <table>
+    <thead><tr><th>사이트</th><th>FPS</th><th></th></tr></thead>
+    <tbody id="sites"></tbody>
+  </table>
+  <form id="add-site">
+    <input id="new-host" placeholder="예: youtube.com" required>
+    <span id="new-fps"></span>
+    <button type="submit">추가</button>
+  </form>
+  <div id="cmdline-sites"></div>
+</section>
+
+<section>
+  <h2>열린 탭</h2>
+  <p class="note">Alt+Shift+F로 현재 탭의 FPS를 바로 바꿀 수 있어요.</p>
+  <table>
+    <thead><tr><th>탭</th><th>지금</th><th>적용 이유</th><th>이 탭만</th><th></th></tr></thead>
+    <tbody id="tabs"></tbody>
+  </table>
+</section>
+</body>
+</html>
+)HTML";
+
+constexpr char kCss[] = R"CSS(
+:root { color-scheme: light dark; --muted: #666; --line: #ddd; }
+@media (prefers-color-scheme: dark) { :root { --muted: #aaa; --line: #444; } }
+body { font: 14px/1.6 system-ui, sans-serif; max-width: 960px; margin: 24px auto;
+       padding: 0 16px; }
+h1 { font-size: 22px; margin-bottom: 4px; }
+h2 { font-size: 16px; margin-top: 28px; }
+.note { color: var(--muted); margin: 4px 0 8px; }
+table { border-collapse: collapse; width: 100%; margin: 8px 0; }
+th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--line);
+         vertical-align: middle; }
+td.title { max-width: 360px; overflow: hidden; text-overflow: ellipsis;
+           white-space: nowrap; }
+.host { color: var(--muted); font-size: 12px; }
+.boost { color: #c60; font-size: 12px; margin-left: 6px; }
+form { display: flex; gap: 8px; margin-top: 8px; }
+label { display: block; margin: 6px 0; }
+)CSS";
+
+constexpr char kJs[] = R"JS(
+const $ = (id) => document.getElementById(id);
+const CHOICES = [0, 60, 30, 15, 5];
+const fpsLabel = (fps) => (fps > 0 ? `${fps} FPS` : '제한 없음');
+const SOURCE = {
+  'tab': '이 탭 고정',
+  'cmdline-site': '실행 옵션 사이트 규칙',
+  'saved-site': '사이트 규칙',
+  'cmdline-default': '실행 옵션 기본값',
+  'default': '기본값',
+};
+
+function el(tag, text) {
+  const node = document.createElement(tag);
+  if (text !== undefined) node.textContent = text;
+  return node;
+}
+
+function fpsSelect(value, onChange, extra) {
+  const select = el('select');
+  for (const [optionValue, text] of extra || []) {
+    select.add(new Option(text, String(optionValue)));
+  }
+  const choices = CHOICES.includes(value) || value < 0 ? CHOICES : [...CHOICES, value];
+  for (const fps of choices) select.add(new Option(fpsLabel(fps), String(fps)));
+  select.value = String(value);
+  select.onchange = () => onChange(Number(select.value));
+  return select;
+}
+
+function button(text, onClick) {
+  const node = el('button', text);
+  node.type = 'button';
+  node.onclick = onClick;
+  return node;
+}
+
+function row(...cells) {
+  const tr = el('tr');
+  for (const cell of cells) {
+    const td = el('td');
+    td.append(cell);
+    tr.append(td);
+  }
+  return tr;
+}
+
+let newFps = 15;
+let latest = null;
+
+function render(state) {
+  $('default').replaceChildren(
+      fpsSelect(state.defaultFps, (fps) => chrome.send('setDefaultFps', [fps])));
+  $('default-note').textContent = state.commandLineDefaultFps === undefined ?
+      '' :
+      `실행 옵션 --framebudget-default-fps=${state.commandLineDefaultFps} 이 우선 적용되고 있어요.`;
+  $('boost').checked = state.inputBoost;
+
+  $('sites').replaceChildren(...state.sites.map((site) => row(
+      site.host,
+      fpsSelect(site.fps, (fps) => chrome.send('setSiteRule', [site.host, fps])),
+      button('삭제', () => chrome.send('removeSiteRule', [site.host])))));
+  $('new-fps').replaceChildren(fpsSelect(newFps, (fps) => { newFps = fps; }));
+
+  const cmdline = $('cmdline-sites');
+  cmdline.replaceChildren();
+  if (state.commandLineSites.length) {
+    cmdline.append(el('p', '실행 옵션 규칙 (저장된 규칙보다 우선, 여기서 바꿀 수 없음): ' +
+        state.commandLineSites.map((s) => `${s.host}=${fpsLabel(s.fps)}`).join(', ')));
+    cmdline.firstChild.className = 'note';
+  }
+
+  $('tabs').replaceChildren(...state.tabs.map((tab) => {
+    const title = el('div', tab.title || '(제목 없음)');
+    const host = el('div', tab.host);
+    host.className = 'host';
+    const titleCell = el('div');
+    titleCell.append(title, host);
+    const now = el('span', fpsLabel(tab.fps));
+    if (tab.boosted) {
+      const boost = el('span', '입력 중이라 잠시 해제');
+      boost.className = 'boost';
+      now.append(boost);
+    }
+    const reason = SOURCE[tab.source] + (tab.rule ? ` (${tab.rule})` : '');
+    const override = fpsSelect(
+        tab.hasOverride ? tab.fps : -1,
+        (fps) => chrome.send('setTabOverride', [tab.id, fps]),
+        [[-1, '규칙 따름']]);
+    const save = button('이 사이트 규칙으로 저장',
+        () => chrome.send('saveTabAsSiteRule', [tab.id]));
+    save.disabled = !tab.host;
+    const tr = row(titleCell, now, reason, override, save);
+    tr.firstChild.className = 'title';
+    return tr;
+  }));
+}
+
+window.framebudget = {
+  onState(state) {
+    latest = state;
+    // Re-rendering replaces the controls, so wait while the user is using one.
+    const active = document.activeElement;
+    if (active && ['SELECT', 'INPUT'].includes(active.tagName)) return;
+    render(state);
+  },
+};
+
+document.addEventListener('focusout', () => {
+  if (latest) setTimeout(() => window.framebudget.onState(latest));
+});
+$('boost').onchange = () => chrome.send('setInputBoost', [$('boost').checked]);
+$('add-site').onsubmit = (event) => {
+  event.preventDefault();
+  chrome.send('setSiteRule', [$('new-host').value, newFps]);
+  $('new-host').value = '';
+};
+
+chrome.send('getState');
+setInterval(() => chrome.send('getState'), 1000);
+)JS";
+
+bool ShouldHandleRequest(const std::string& path) {
+  return true;
+}
+
+void HandleRequest(const std::string& path,
+                   content::WebUIDataSource::GotDataCallback callback) {
+  std::string body = kHtml;
+  if (path.ends_with(".js")) {
+    body = kJs;
+  } else if (path.ends_with(".css")) {
+    body = kCss;
+  }
+  std::move(callback).Run(
+      base::MakeRefCounted<base::RefCountedString>(std::move(body)));
+}
+
+// JS numbers may arrive as doubles.
+std::optional<int> GetInt(const base::Value& value) {
+  if (value.is_int()) {
+    return value.GetInt();
+  }
+  if (value.is_double()) {
+    return static_cast<int>(value.GetDouble());
+  }
+  return std::nullopt;
+}
+
+class FrameBudgetHandler : public content::WebUIMessageHandler {
+ public:
+  FrameBudgetHandler() = default;
+  FrameBudgetHandler(const FrameBudgetHandler&) = delete;
+  FrameBudgetHandler& operator=(const FrameBudgetHandler&) = delete;
+  ~FrameBudgetHandler() override = default;
+
+  // content::WebUIMessageHandler:
+  void RegisterMessages() override {
+    Register("getState", &FrameBudgetHandler::HandleGetState);
+    Register("setDefaultFps", &FrameBudgetHandler::HandleSetDefaultFps);
+    Register("setInputBoost", &FrameBudgetHandler::HandleSetInputBoost);
+    Register("setSiteRule", &FrameBudgetHandler::HandleSetSiteRule);
+    Register("removeSiteRule", &FrameBudgetHandler::HandleRemoveSiteRule);
+    Register("setTabOverride", &FrameBudgetHandler::HandleSetTabOverride);
+    Register("saveTabAsSiteRule", &FrameBudgetHandler::HandleSaveTabAsSiteRule);
+  }
+
+ private:
+  using Handler = void (FrameBudgetHandler::*)(const base::ListValue&);
+
+  void Register(std::string_view message, Handler handler) {
+    web_ui()->RegisterMessageCallback(
+        message, base::BindRepeating(handler, base::Unretained(this)));
+  }
+
+  content::BrowserContext* context() {
+    return web_ui()->GetWebContents()->GetBrowserContext();
+  }
+
+  PrefService* prefs() { return user_prefs::UserPrefs::Get(context()); }
+
+  // Returns the helper of tab `value` if it belongs to this profile.
+  FrameBudgetTabHelper* FindTab(const base::Value& value) {
+    std::optional<int> id = GetInt(value);
+    FrameBudgetTabHelper* helper =
+        id ? FrameBudgetTabHelper::FromId(*id) : nullptr;
+    if (!helper || helper->web_contents()->GetBrowserContext() != context()) {
+      return nullptr;
+    }
+    return helper;
+  }
+
+  void HandleGetState(const base::ListValue& args) { SendState(); }
+
+  void HandleSetDefaultFps(const base::ListValue& args) {
+    if (args.size() == 1) {
+      if (std::optional<int> fps = GetInt(args[0])) {
+        prefs()->SetInteger(framebudget::kDefaultFpsPref,
+                            framebudget::ClampFps(*fps));
+      }
+    }
+    SendState();
+  }
+
+  void HandleSetInputBoost(const base::ListValue& args) {
+    if (args.size() == 1 && args[0].is_bool()) {
+      prefs()->SetBoolean(framebudget::kInputBoostPref, args[0].GetBool());
+    }
+    SendState();
+  }
+
+  void HandleSetSiteRule(const base::ListValue& args) {
+    if (args.size() == 2 && args[0].is_string()) {
+      const std::string host = framebudget::NormalizeHost(args[0].GetString());
+      std::optional<int> fps = GetInt(args[1]);
+      if (!host.empty() && fps) {
+        ScopedDictPrefUpdate(prefs(), framebudget::kSitesPref)
+            ->Set(host, framebudget::ClampFps(*fps));
+      }
+    }
+    SendState();
+  }
+
+  void HandleRemoveSiteRule(const base::ListValue& args) {
+    if (args.size() == 1 && args[0].is_string()) {
+      ScopedDictPrefUpdate(prefs(), framebudget::kSitesPref)
+          ->Remove(args[0].GetString());
+    }
+    SendState();
+  }
+
+  // Args: tab id, FPS (negative clears the override).
+  void HandleSetTabOverride(const base::ListValue& args) {
+    if (args.size() == 2) {
+      FrameBudgetTabHelper* helper = FindTab(args[0]);
+      std::optional<int> fps = GetInt(args[1]);
+      if (helper && fps) {
+        helper->SetTabOverride(*fps < 0 ? std::nullopt
+                                        : std::optional<int>(*fps));
+      }
+    }
+    SendState();
+  }
+
+  void HandleSaveTabAsSiteRule(const base::ListValue& args) {
+    if (args.size() == 1) {
+      if (FrameBudgetTabHelper* helper = FindTab(args[0])) {
+        helper->SaveAsSiteRule();
+      }
+    }
+    SendState();
+  }
+
+  void SendState() {
+    AllowJavascript();
+    CallJavascriptFunction("framebudget.onState", base::Value(BuildState()));
+  }
+
+  base::DictValue BuildState() {
+    const framebudget::CommandLineConfig& command_line =
+        framebudget::GetCommandLineConfig();
+    base::DictValue state;
+    state.Set("defaultFps", prefs()->GetInteger(framebudget::kDefaultFpsPref));
+    if (command_line.default_fps) {
+      state.Set("commandLineDefaultFps", *command_line.default_fps);
+    }
+    state.Set("inputBoost",
+              prefs()->GetBoolean(framebudget::kInputBoostPref));
+
+    base::ListValue sites;
+    for (const auto [host, value] :
+         prefs()->GetDict(framebudget::kSitesPref)) {
+      if (std::optional<int> fps = value.GetIfInt()) {
+        base::DictValue site;
+        site.Set("host", host);
+        site.Set("fps", *fps);
+        sites.Append(std::move(site));
+      }
+    }
+    state.Set("sites", std::move(sites));
+
+    base::ListValue command_line_sites;
+    for (const auto& [host, fps] : command_line.sites) {
+      base::DictValue site;
+      site.Set("host", host);
+      site.Set("fps", fps);
+      command_line_sites.Append(std::move(site));
+    }
+    state.Set("commandLineSites", std::move(command_line_sites));
+
+    base::ListValue tabs;
+    for (FrameBudgetTabHelper* helper : FrameBudgetTabHelper::GetAll()) {
+      content::WebContents* contents = helper->web_contents();
+      if (contents->GetBrowserContext() != context()) {
+        continue;
+      }
+      const framebudget::Decision decision = helper->Decide();
+      base::DictValue tab;
+      tab.Set("id", helper->id());
+      tab.Set("title", base::UTF16ToUTF8(contents->GetTitle()));
+      tab.Set("host", helper->host());
+      tab.Set("fps", decision.fps);
+      tab.Set("source", framebudget::SourceId(decision.source));
+      tab.Set("rule", decision.rule);
+      tab.Set("boosted", helper->boosted());
+      tab.Set("hasOverride", helper->tab_override().has_value());
+      tabs.Append(std::move(tab));
+    }
+    state.Set("tabs", std::move(tabs));
+    return state;
+  }
+};
+
+}  // namespace
+
+FrameBudgetUIConfig::FrameBudgetUIConfig()
+    : DefaultWebUIConfig(content::kChromeUIScheme, kHost) {}
+
+FrameBudgetUI::FrameBudgetUI(content::WebUI* web_ui)
+    : content::WebUIController(web_ui) {
+  content::WebUIDataSource* source = content::WebUIDataSource::CreateAndAdd(
+      web_ui->GetWebContents()->GetBrowserContext(), kHost);
+  source->SetRequestFilter(base::BindRepeating(&ShouldHandleRequest),
+                           base::BindRepeating(&HandleRequest));
+  web_ui->AddMessageHandler(std::make_unique<FrameBudgetHandler>());
+}
+
+FrameBudgetUI::~FrameBudgetUI() = default;
