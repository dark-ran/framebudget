diff --git a/chrome/browser/ui/framebudget/framebudget_policy.cc b/chrome/browser/ui/framebudget/framebudget_policy.cc
new file mode 100644
index 0000000000..0b60d48238
--- /dev/null
+++ b/chrome/browser/ui/framebudget/framebudget_policy.cc
@@ -0,0 +1,147 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/framebudget/framebudget_policy.h"
+
+#include <algorithm>
+
+#include "base/command_line.h"
+#include "base/logging.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "base/values.h"
+#include "components/pref_registry/pref_registry_syncable.h"
+#include "components/prefs/pref_service.h"
+
+namespace framebudget {
+
+namespace {
+
+constexpr char kDefaultFpsSwitch[] = "framebudget-default-fps";
+constexpr char kSitesSwitch[] = "framebudget-sites";
+constexpr int kMaxFps = 240;
+
+// Returns `value` as an FPS, or nullopt if it is not a number.
+std::optional<int> ParseFps(std::string_view value) {
+  int fps = 0;
+  if (!base::StringToInt(value, &fps)) {
+    return std::nullopt;
+  }
+  return ClampFps(fps);
+}
+
+// True if `host` is `site` or one of its subdomains.
+bool HostMatches(std::string_view host, std::string_view site) {
+  return host == site || (host.ends_with(site) && host.size() > site.size() &&
+                          host[host.size() - site.size() - 1] == '.');
+}
+
+}  // namespace
+
+CommandLineConfig::CommandLineConfig() {
+  const base::CommandLine& command_line =
+      *base::CommandLine::ForCurrentProcess();
+  if (command_line.HasSwitch(kDefaultFpsSwitch)) {
+    default_fps = ParseFps(command_line.GetSwitchValueASCII(kDefaultFpsSwitch));
+  }
+  const std::string rules = command_line.GetSwitchValueASCII(kSitesSwitch);
+  for (std::string_view rule :
+       base::SplitStringPiece(rules, ",", base::TRIM_WHITESPACE,
+                              base::SPLIT_WANT_NONEMPTY)) {
+    std::vector<std::string_view> parts = base::SplitStringPiece(
+        rule, "=", base::TRIM_WHITESPACE, base::SPLIT_WANT_ALL);
+    std::optional<int> fps =
+        parts.size() == 2 ? ParseFps(parts[1]) : std::nullopt;
+    std::string host = parts.empty() ? std::string() : NormalizeHost(parts[0]);
+    if (!fps || host.empty()) {
+      LOG(WARNING) << "FrameBudget: ignoring malformed site rule: " << rule;
+      continue;
+    }
+    sites.emplace_back(std::move(host), *fps);
+  }
+}
+
+CommandLineConfig::~CommandLineConfig() = default;
+
+void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry) {
+  registry->RegisterIntegerPref(kDefaultFpsPref, 0);
+  registry->RegisterDictionaryPref(kSitesPref);
+  registry->RegisterBooleanPref(kInputBoostPref, true);
+}
+
+const CommandLineConfig& GetCommandLineConfig() {
+  static const base::NoDestructor<CommandLineConfig> config;
+  return *config;
+}
+
+Decision Decide(const PrefService& prefs,
+                std::string_view host,
+                std::optional<int> tab_override) {
+  if (tab_override) {
+    return {ClampFps(*tab_override), Source::kTabOverride, ""};
+  }
+
+  const CommandLineConfig& command_line = GetCommandLineConfig();
+  for (const auto& [site, fps] : command_line.sites) {
+    if (HostMatches(host, site)) {
+      return {fps, Source::kCommandLineSite, site};
+    }
+  }
+
+  // Among saved rules the most specific domain wins.
+  const base::DictValue& saved = prefs.GetDict(kSitesPref);
+  std::string_view candidate = host;
+  while (!candidate.empty()) {
+    if (std::optional<int> fps = saved.FindInt(candidate)) {
+      return {ClampFps(*fps), Source::kSavedSite, std::string(candidate)};
+    }
+    const size_t dot = candidate.find('.');
+    if (dot == std::string_view::npos) {
+      break;
+    }
+    candidate = candidate.substr(dot + 1);
+  }
+
+  if (command_line.default_fps) {
+    return {*command_line.default_fps, Source::kCommandLineDefault, ""};
+  }
+  return {ClampFps(prefs.GetInteger(kDefaultFpsPref)), Source::kSavedDefault,
+          ""};
+}
+
+std::string_view SourceId(Source source) {
+  switch (source) {
+    case Source::kTabOverride:
+      return "tab";
+    case Source::kCommandLineSite:
+      return "cmdline-site";
+    case Source::kSavedSite:
+      return "saved-site";
+    case Source::kCommandLineDefault:
+      return "cmdline-default";
+    case Source::kSavedDefault:
+      return "default";
+  }
+}
+
+int ClampFps(int fps) {
+  return std::clamp(fps, 0, kMaxFps);
+}
+
+std::string NormalizeHost(std::string_view input) {
+  std::string_view host = base::TrimWhitespaceASCII(input, base::TRIM_ALL);
+  if (const size_t scheme = host.find("://");
+      scheme != std::string_view::npos) {
+    host = host.substr(scheme + 3);
+  }
+  host = host.substr(0, host.find_first_of("/?#:"));
+  while (host.ends_with('.')) {
+    host.remove_suffix(1);
+  }
+  return base::ToLowerASCII(host);
+}
+
+}  // namespace framebudget
