new file mode 100644
index 0000000000..6018c33685
--- /dev/null
+++ b/chrome/browser/ui/framebudget/framebudget_policy.h
@@ -0,0 +1,84 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_FRAMEBUDGET_FRAMEBUDGET_POLICY_H_
+#define CHROME_BROWSER_UI_FRAMEBUDGET_FRAMEBUDGET_POLICY_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+class PrefService;
+
+namespace user_prefs {
+class PrefRegistrySyncable;
+}
+
+// FrameBudget: decides how many frames per second a tab's web content may
+// produce. An FPS of 0 means no limit.
+namespace framebudget {
+
+// Profile prefs, edited on chrome://framebudget.
+inline constexpr char kDefaultFpsPref[] = "framebudget.default_fps";
+// Dictionary of host -> FPS. A rule also covers the host's subdomains.
+inline constexpr char kSitesPref[] = "framebudget.sites";
+// Whether user input briefly lifts the limit of a tab.
+inline constexpr char kInputBoostPref[] = "framebudget.input_boost";
+
+void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry);
+
+// Command line rules, which take priority over the saved ones:
+//   --framebudget-default-fps=15
+//   --framebudget-sites=youtube.com=60,example.com=15
+struct CommandLineConfig {
+  // Parses the current process's command line.
+  CommandLineConfig();
+  CommandLineConfig(const CommandLineConfig&) = delete;
+  CommandLineConfig& operator=(const CommandLineConfig&) = delete;
+  ~CommandLineConfig();
+
+  std::optional<int> default_fps;
+  // (host, fps) in command line order. The first match wins.
+  std::vector<std::pair<std::string, int>> sites;
+};
+const CommandLineConfig& GetCommandLineConfig();
+
+// Where the FPS of a tab comes from, from highest to lowest priority.
+enum class Source {
+  kTabOverride,
+  kCommandLineSite,
+  kSavedSite,
+  kCommandLineDefault,
+  kSavedDefault,
+};
+
+struct Decision {
+  int fps = 0;
+  Source source = Source::kSavedDefault;
+  // The matching site rule's host, for kCommandLineSite and kSavedSite.
+  std::string rule;
+};
+
+// Decides the FPS for a tab showing `host`. `tab_override` is the tab's own
+// override, if any.
+Decision Decide(const PrefService& prefs,
+                std::string_view host,
+                std::optional<int> tab_override);
+
+// Stable identifier of `source`, used by chrome://framebudget.
+std::string_view SourceId(Source source);
+
+// Clamps `fps` into [0, 240]; anything not positive means no limit.
+int ClampFps(int fps);
+
+// Lower-cases `input` and strips a scheme, path and port, so that
+// "https://Example.com/x" becomes "example.com". Returns an empty string if
+// nothing usable is left.
+std::string NormalizeHost(std::string_view input);
+
+}  // namespace framebudget
+
+#endif  // CHROME_BROWSER_UI_FRAMEBUDGET_FRAMEBUDGET_POLICY_H_
