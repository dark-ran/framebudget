첫 빌드에서 두 오류가 났다.
- host()가 std::string_view를 std::string으로 암시 변환해 실패: 명시적으로 std::string 생성
- prefs()가 BrowserContext를 SupportsUserData로 변환할 때 전방 선언만 보여 실패: browser_context.h include 추가
---
 chrome/browser/ui/framebudget/framebudget_tab_helper.cc | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/chrome/browser/ui/framebudget/framebudget_tab_helper.cc b/chrome/browser/ui/framebudget/framebudget_tab_helper.cc
index 9e4e269bcb..bd049e11cd 100644
--- a/chrome/browser/ui/framebudget/framebudget_tab_helper.cc
+++ b/chrome/browser/ui/framebudget/framebudget_tab_helper.cc
@@ -18,6 +18,7 @@
 #include "components/prefs/pref_service.h"
 #include "components/prefs/scoped_user_pref_update.h"
 #include "components/user_prefs/user_prefs.h"
+#include "content/public/browser/browser_context.h"
 #include "content/public/browser/frame_rate_throttling.h"
 #include "content/public/browser/render_frame_host.h"
 #include "content/public/browser/web_contents.h"
@@ -157,7 +158,7 @@ framebudget::Decision FrameBudgetTabHelper::Decide() const {
 }
 
 std::string FrameBudgetTabHelper::host() const {
-  return web_contents()->GetLastCommittedURL().host();
+  return std::string(web_contents()->GetLastCommittedURL().host());
 }
 
 void FrameBudgetTabHelper::RenderFrameCreated(
