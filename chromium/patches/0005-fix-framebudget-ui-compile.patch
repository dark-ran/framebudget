두 번째 빌드에서 framebudget_ui.cc의 prefs()가 같은 이유로 실패했다.
BrowserContext가 전방 선언만 보여서 SupportsUserData로 변환되지 않아, browser_context.h를 include했다.
---
 chrome/browser/ui/framebudget/framebudget_ui.cc | 1 +
 1 file changed, 1 insertion(+)

diff --git a/chrome/browser/ui/framebudget/framebudget_ui.cc b/chrome/browser/ui/framebudget/framebudget_ui.cc
index fa720430b9..317e496836 100644
--- a/chrome/browser/ui/framebudget/framebudget_ui.cc
+++ b/chrome/browser/ui/framebudget/framebudget_ui.cc
@@ -18,6 +18,7 @@
 #include "components/prefs/pref_service.h"
 #include "components/prefs/scoped_user_pref_update.h"
 #include "components/user_prefs/user_prefs.h"
+#include "content/public/browser/browser_context.h"
 #include "content/public/browser/web_contents.h"
 #include "content/public/browser/web_ui.h"
 #include "content/public/browser/web_ui_data_source.h"
