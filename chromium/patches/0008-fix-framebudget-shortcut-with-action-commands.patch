Chromium 156은 kUseActionsForBrowserCommands가 켜져 있으면 명령 등록부로
CommandActionUpdater를 쓴다. 이 등록부는 액션 표에 있는 명령만 인정하므로
IDC_FRAMEBUDGET_CYCLE_TAB_FPS는 SupportsCommand가 false가 되어 버려졌다.
단축키 통계에는 명령이 기록되지만 탭 고정 값이 바뀌지 않는 것으로 확인했다.
BrowserView::AcceleratorPressed에서 이 명령을 탭 헬퍼로 직접 넘긴다.
---
 chrome/browser/ui/views/frame/browser_view.cc | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/chrome/browser/ui/views/frame/browser_view.cc b/chrome/browser/ui/views/frame/browser_view.cc
index b68f089aeb..d916437dd5 100644
--- a/chrome/browser/ui/views/frame/browser_view.cc
+++ b/chrome/browser/ui/views/frame/browser_view.cc
@@ -99,6 +99,7 @@
 #include "chrome/browser/ui/exclusive_access/fullscreen_tab_params.h"
 #include "chrome/browser/ui/find_bar/find_bar.h"
 #include "chrome/browser/ui/focus/browser_focus_controller.h"
+#include "chrome/browser/ui/framebudget/framebudget_tab_helper.h"
 #include "chrome/browser/ui/fullscreen/browser_window_fullscreen_controller.h"
 #include "chrome/browser/ui/global_error/global_error.h"
 #include "chrome/browser/ui/global_error/global_error_service.h"
@@ -5263,6 +5264,17 @@ bool BrowserView::AcceleratorPressed(const ui::Accelerator& accelerator) {
 
   UpdateAcceleratorMetrics(accelerator, command_id);
 
+  // FrameBudget has no action item, so the actions-based command updater
+  // would drop it. Handle the shortcut directly.
+  if (command_id == IDC_FRAMEBUDGET_CYCLE_TAB_FPS) {
+    if (content::WebContents* contents = GetActiveWebContents()) {
+      if (auto* helper = FrameBudgetTabHelper::FromWebContents(contents)) {
+        helper->CycleTabOverride();
+      }
+    }
+    return true;
+  }
+
   if (command_id == IDC_CLEAR_BROWSING_DATA) {
     views::ElementTrackerViews::GetInstance()->NotifyCustomEvent(
         browsing_data_important_sites_util::
