+  // Hosts where input never lifts the limit.
+  std::vector<std::string> no_input_boost_sites;
 };
 const CommandLineConfig& GetCommandLineConfig();
 
@@ -68,6 +75,9 @@ Decision Decide(const PrefService& prefs,
                 std::string_view host,
                 std::optional<int> tab_override);
 
+// Whether user input may briefly lift the limit of a tab showing `host`.
+bool InputBoostAllowed(const PrefService& prefs, std::string_view host);
+
