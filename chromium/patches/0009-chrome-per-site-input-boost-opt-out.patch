게임처럼 계속 입력하는 사이트에서는 입력 때마다 제한이 1초씩 풀려서
사실상 제한이 걸리지 않았다. framebudget.no_input_boost_sites 목록과
--framebudget-no-input-boost 실행 옵션을 추가하고, 목록의 사이트(하위 도메인
포함)에서는 입력이 있어도 제한을 유지한다. chrome://framebudget의 사이트
규칙마다 '입력 시 해제' 체크 상자를 두고, 규칙을 지우면 목록에서도 지운다.
---
 .../ui/framebudget/framebudget_policy.cc      | 26 +++++++++
 .../ui/framebudget/framebudget_policy.h       | 10 ++++
 .../ui/framebudget/framebudget_tab_helper.cc  |  6 +-
 .../browser/ui/framebudget/framebudget_ui.cc  | 55 +++++++++++++++++--
 4 files changed, 88 insertions(+), 9 deletions(-)

diff --git a/chrome/browser/ui/framebudget/framebudget_policy.cc b/chrome/browser/ui/framebudget/framebudget_policy.cc
index 63a0c2dbc9..cda2118da5 100644
--- a/chrome/browser/ui/framebudget/framebudget_policy.cc
+++ b/chrome/browser/ui/framebudget/framebudget_policy.cc
@@ -22,6 +22,7 @@ namespace {
 
 constexpr char kDefaultFpsSwitch[] = "framebudget-default-fps";
 constexpr char kSitesSwitch[] = "framebudget-sites";
+constexpr char kNoInputBoostSwitch[] = "framebudget-no-input-boost";
 constexpr int kMaxFps = 240;
 
 // Returns `value` as an FPS, or nullopt if it is not a number.
@@ -62,6 +63,13 @@ CommandLineConfig::CommandLineConfig() {
     }
     sites.emplace_back(std::move(host), *fps);
   }
+  for (std::string_view site : base::SplitStringPiece(
+           command_line.GetSwitchValueASCII(kNoInputBoostSwitch), ",",
+           base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    if (std::string host = NormalizeHost(site); !host.empty()) {
+      no_input_boost_sites.push_back(std::move(host));
+    }
+  }
 }
 
 CommandLineConfig::~CommandLineConfig() = default;
@@ -70,6 +78,7 @@ void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry) {
   registry->RegisterIntegerPref(kDefaultFpsPref, 0);
   registry->RegisterDictionaryPref(kSitesPref);
   registry->RegisterBooleanPref(kInputBoostPref, true);
+  registry->RegisterListPref(kNoInputBoostSitesPref);
 }
 
 const CommandLineConfig& GetCommandLineConfig() {
@@ -112,6 +121,23 @@ Decision Decide(const PrefService& prefs,
           ""};
 }
 
+bool InputBoostAllowed(const PrefService& prefs, std::string_view host) {
+  if (!prefs.GetBoolean(kInputBoostPref)) {
+    return false;
+  }
+  for (const std::string& site : GetCommandLineConfig().no_input_boost_sites) {
+    if (HostMatches(host, site)) {
+      return false;
+    }
+  }
+  for (const base::Value& site : prefs.GetList(kNoInputBoostSitesPref)) {
+    if (site.is_string() && HostMatches(host, site.GetString())) {
+      return false;
+    }
+  }
+  return true;
+}
+
 std::string_view SourceId(Source source) {
   switch (source) {
     case Source::kTabOverride:
