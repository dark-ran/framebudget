+
+void FrameBudgetTabHelper::ObserveWindow() {
+  tabs::TabInterface* tab = tabs::TabInterface::MaybeGetFromContents(
+      web_contents());
+  if (!tab) {
+    return;
+  }
+  if (!tab_inserted_subscription_) {
+    tab_inserted_subscription_ = tab->RegisterDidInsert(base::BindRepeating(
+        &FrameBudgetTabHelper::OnTabInserted, base::Unretained(this)));
+  }
+  BrowserWindowInterface* window = tab->GetBrowserWindowInterface();
+  const SessionID id = window ? window->GetSessionID() : SessionID::InvalidValue();
+  if (id == observed_window_) {
+    return;
+  }
+  observed_window_ = id;
+  window_active_subscription_ = {};
+  window_inactive_subscription_ = {};
+  if (window) {
+    window_active_subscription_ =
+        window->RegisterDidBecomeActive(base::BindRepeating(
+            &FrameBudgetTabHelper::OnWindowActivationChanged,
+            base::Unretained(this)));
+    window_inactive_subscription_ =
+        window->RegisterDidBecomeInactive(base::BindRepeating(
+            &FrameBudgetTabHelper::OnWindowActivationChanged,
+            base::Unretained(this)));
+  }
+}
+
+void FrameBudgetTabHelper::OnTabInserted(tabs::TabInterface* tab) {
+  Apply();
+}
+
+void FrameBudgetTabHelper::OnWindowActivationChanged(
+    BrowserWindowInterface* window) {
+  Apply();
+}
+
+bool FrameBudgetTabHelper::IsWindowActive() const {
+  tabs::TabInterface* tab = tabs::TabInterface::MaybeGetFromContents(
+      web_contents());
+  BrowserWindowInterface* window =
+      tab ? tab->GetBrowserWindowInterface() : nullptr;
+  return !window || window->IsActive();
+}
+
 void FrameBudgetTabHelper::Apply() {
+  ObserveWindow();
   content::RenderWidgetHost* widget =
       web_contents()->GetPrimaryMainFrame()->GetRenderWidgetHost();
   ObserveWidget(widget);
