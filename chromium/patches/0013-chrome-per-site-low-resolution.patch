     base::TimeDelta interval);
 
+// FrameBudget: makes the page in `widget` render at `device_scale_factor`
+// (e.g. 0.5) while keeping its layout size; the compositor scales the result
+// up. Pages that size canvases by devicePixelRatio then draw fewer pixels. A
+// non-positive value turns it off. This uses the same mechanism as DevTools
+// device emulation and replaces any emulation DevTools has set on `widget`.
+CONTENT_EXPORT void SetFrameBudgetDeviceScaleFactor(RenderWidgetHost* widget,
+                                                    float device_scale_factor);
+
 }  // namespace content
 
 #endif  // CONTENT_PUBLIC_BROWSER_FRAME_RATE_THROTTLING_H_
