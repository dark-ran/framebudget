+void SetFrameBudgetDeviceScaleFactor(RenderWidgetHost* widget,
+                                     float device_scale_factor) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  auto& frame_widget =
+      static_cast<RenderWidgetHostImpl*>(widget)->GetAssociatedFrameWidget();
+  if (!frame_widget) {
+    return;
+  }
+  if (device_scale_factor <= 0) {
+    frame_widget->DisableDeviceEmulation();
+    return;
+  }
+  blink::DeviceEmulationParams params;
+  params.screen_type = blink::mojom::EmulatedScreenType::kDesktop;
+  params.device_scale_factor = device_scale_factor;
+  params.scale = 1;
+  frame_widget->EnableDeviceEmulation(
+      params, blink::mojom::DeviceEmulationCacheBehavior::kKeepCache);
+}
+
 }  // namespace content
