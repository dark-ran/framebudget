     case framebudget::Source::kSavedDefault:
@@ -132,6 +134,7 @@ FrameBudgetTabHelper::FrameBudgetTabHelper(content::WebContents* web_contents)
        {framebudget::kDefaultFpsPref, framebudget::kSitesPref,
