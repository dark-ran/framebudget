Content-Transfer-Encoding: 8bit

framebudget.lift_during_video / --framebudget-lift-during-video를 켜면
영상이 있는 미디어가 재생되는 동안 그 탭의 제한을 푼다. 기본값을 낮게 잡아도
페이지에 끼워 넣은 영상이 끊기지 않게 하려는 것이다. 탭 고정은 그대로
우선한다. WebContentsObserver::MediaStarted/StoppedPlaying으로 센다.
---
 .../ui/framebudget/framebudget_policy.cc      | 17 +++++++++++--
 .../ui/framebudget/framebudget_policy.h       | 12 ++++++++--
 .../ui/framebudget/framebudget_tab_helper.cc  | 24 ++++++++++++++++++-
 .../ui/framebudget/framebudget_tab_helper.h   |  6 +++++
 .../browser/ui/framebudget/framebudget_ui.cc  | 15 ++++++++++++
 5 files changed, 69 insertions(+), 5 deletions(-)

diff --git a/chrome/browser/ui/framebudget/framebudget_policy.cc b/chrome/browser/ui/framebudget/framebudget_policy.cc
index 8c5816253e..59c85259c3 100644
--- a/chrome/browser/ui/framebudget/framebudget_policy.cc
+++ b/chrome/browser/ui/framebudget/framebudget_policy.cc
@@ -28,6 +28,7 @@ constexpr char kLowResSwitch[] = "framebudget-low-res";
 constexpr char kInactiveWindowFpsSwitch[] = "framebudget-inactive-window-fps";
 constexpr char kBatteryDefaultFpsSwitch[] = "framebudget-battery-default-fps";
 constexpr char kAssumeBatterySwitch[] = "framebudget-assume-battery";
+constexpr char kLiftDuringVideoSwitch[] = "framebudget-lift-during-video";
 constexpr int kMaxFps = 240;
 
 // Returns `value` as an FPS, or nullopt if it is not a number.
@@ -88,6 +89,7 @@ CommandLineConfig::CommandLineConfig() {
         ParseFps(command_line.GetSwitchValueASCII(kBatteryDefaultFpsSwitch));
   }
   assume_battery = command_line.HasSwitch(kAssumeBatterySwitch);
+  lift_during_video = command_line.HasSwitch(kLiftDuringVideoSwitch);
 }
 
 CommandLineConfig::~CommandLineConfig() = default;
@@ -98,6 +100,7 @@ void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry) {
   registry->RegisterBooleanPref(kInputBoostPref, true);
   registry->RegisterListPref(kNoInputBoostSitesPref);
   registry->RegisterListPref(kLowResSitesPref);
+  registry->RegisterBooleanPref(kLiftDuringVideoPref, false);
   registry->RegisterIntegerPref(kInactiveWindowFpsPref, 0);
   registry->RegisterIntegerPref(kBatteryDefaultFpsPref, 0);
 }
@@ -164,9 +167,17 @@ Decision DecideIgnoringWindow(const PrefService& prefs,
 Decision Decide(const PrefService& prefs,
                 std::string_view host,
                 std::optional<int> tab_override,
-                bool window_active) {
+                bool window_active,
+                bool video_playing) {
   Decision decision = DecideIgnoringWindow(prefs, host, tab_override);
-  if (window_active || decision.source == Source::kTabOverride) {
+  if (decision.source == Source::kTabOverride) {
+    return decision;
+  }
+  if (video_playing && (GetCommandLineConfig().lift_during_video ||
+                        prefs.GetBoolean(kLiftDuringVideoPref))) {
+    return {0, Source::kVideoPlaying, ""};
+  }
+  if (window_active) {
     return decision;
   }
   const int inactive = GetCommandLineConfig().inactive_window_fps.value_or(
@@ -225,6 +236,8 @@ std::string_view SourceId(Source source) {
       return "default";
     case Source::kInactiveWindow:
       return "inactive-window";
+    case Source::kVideoPlaying:
+      return "video-playing";
   }
 }
 
diff --git a/chrome/browser/ui/framebudget/framebudget_policy.h b/chrome/browser/ui/framebudget/framebudget_policy.h
index 261bf108e6..d8b1756c82 100644
--- a/chrome/browser/ui/framebudget/framebudget_policy.h
+++ b/chrome/browser/ui/framebudget/framebudget_policy.h
@@ -39,6 +39,8 @@ inline constexpr char kNoInputBoostSitesPref[] =
     "framebudget.no_input_boost_sites";
 // List of hosts rendered at a lower resolution (kLowResScale).
 inline constexpr char kLowResSitesPref[] = "framebudget.low_res_sites";
+// Whether a tab playing video runs without a limit.
+inline constexpr char kLiftDuringVideoPref[] = "framebudget.lift_during_video";
 // shortcut: one fixed scale for every low-res site; make it a setting if users
 // need to pick per site.
 inline constexpr float kLowResScale = 0.5f;
@@ -50,6 +52,7 @@ void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry);
 //   --framebudget-sites=youtube.com=60,example.com=15
 //   --framebudget-no-input-boost=game.example,play.example
 //   --framebudget-low-res=game.example,play.example
+//   --framebudget-lift-during-video
 //   --framebudget-inactive-window-fps=10
 //   --framebudget-battery-default-fps=20
 //   --framebudget-assume-battery  (behave as if on battery, for testing)
@@ -70,6 +73,7 @@ struct CommandLineConfig {
   std::optional<int> inactive_window_fps;
   std::optional<int> battery_default_fps;
   bool assume_battery = false;
+  bool lift_during_video = false;
 };
 const CommandLineConfig& GetCommandLineConfig();
 
@@ -83,6 +87,8 @@ enum class Source {
   kSavedDefault,
   // Lowers any of the above except kTabOverride while the window is inactive.
   kInactiveWindow,
+  // No limit while the tab plays video, if enabled. Beats all but kTabOverride.
+  kVideoPlaying,
 };
 
 struct Decision {
@@ -93,11 +99,13 @@ struct Decision {
 };
 
 // Decides the FPS for a tab showing `host`. `tab_override` is the tab's own
-// override, if any. `window_active` is whether the tab's window is active.
+// override, if any. `window_active` is whether the tab's window is active, and
+// `video_playing` whether the tab is playing video.
 Decision Decide(const PrefService& prefs,
                 std::string_view host,
                 std::optional<int> tab_override,
-                bool window_active = true);
+                bool window_active = true,
+                bool video_playing = false);
 
 // Whether the battery default applies now.
 bool OnBattery();
