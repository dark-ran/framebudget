         framebudget::kInactiveWindowFpsPref, framebudget::kLowResSitesPref,
+        framebudget::kLiftDuringVideoPref,
         framebudget::kBatteryDefaultFpsPref}) {
     pref_change_registrar_.Add(
         pref, base::BindRepeating(&FrameBudgetTabHelper::Apply,
@@ -195,7 +198,7 @@ void FrameBudgetTabHelper::SaveAsSiteRule() {
 
 framebudget::Decision FrameBudgetTabHelper::Decide() const {
   return framebudget::Decide(*prefs(), host(), tab_override_fps_,
-                             IsWindowActive());
+                             IsWindowActive(), playing_videos_ > 0);
 }
 
 std::string FrameBudgetTabHelper::host() const {
@@ -269,6 +272,25 @@ void FrameBudgetTabHelper::RenderWidgetHostDestroyed(
   widget_observation_.Reset();
 }
 
+void FrameBudgetTabHelper::MediaStartedPlaying(
+    const MediaPlayerInfo& video_type,
+    const content::MediaPlayerId& id) {
+  if (video_type.has_video) {
+    ++playing_videos_;
+    Apply();
+  }
+}
+
+void FrameBudgetTabHelper::MediaStoppedPlaying(
+    const MediaPlayerInfo& video_type,
+    const content::MediaPlayerId& id,
+    MediaStoppedReason reason) {
+  if (video_type.has_video && playing_videos_ > 0) {
+    --playing_videos_;
+    Apply();
+  }
+}
+
 void FrameBudgetTabHelper::OnBatteryPowerStatusChange(
     BatteryPowerStatus battery_power_status) {
   Apply();
