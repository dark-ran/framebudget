+          actions::ActionIdMap::ActionIdToString(kActionFrameBudget);
+      framebudget_action.has_value()) {
+    default_pinned_actions.Append(framebudget_action.value());
+  }
 
   if (base::FeatureList::IsEnabled(
           features::kTabsFromOtherDevicesSidePanelPinnedByDefault)) {
