IDC_FRAMEBUDGET_CYCLE_TAB_FPS를 kActionFrameBudget으로 액션 표에 등록하고,
누르면 현재 탭의 FPS를 바꾸는 고정 가능한 툴바 버튼을 만든다. 새 프로필에서는
기본으로 고정한다. 명령이 액션 체계로 실행되므로 0008에서 BrowserView에
넣은 단축키 우회 코드를 지운다.
---
 chrome/browser/ui/actions/chrome_action_id.h  |  1 +
 chrome/browser/ui/browser_actions.cc          | 27 +++++++++++++++++++
 .../browser/ui/toolbar/toolbar_pref_names.cc  |  6 +++++
 chrome/browser/ui/views/frame/browser_view.cc | 12 ---------
 4 files changed, 34 insertions(+), 12 deletions(-)

diff --git a/chrome/browser/ui/actions/chrome_action_id.h b/chrome/browser/ui/actions/chrome_action_id.h
index 49f05998da..71e0551898 100644
--- a/chrome/browser/ui/actions/chrome_action_id.h
+++ b/chrome/browser/ui/actions/chrome_action_id.h
@@ -543,6 +543,7 @@
   E(kActionTaskManagerContextMenu, IDC_TASK_MANAGER_CONTEXT_MENU) \
   E(kActionTaskManagerMainMenu, IDC_TASK_MANAGER_MAIN_MENU) \
   E(kActionDevTools, IDC_DEV_TOOLS) \
+  E(kActionFrameBudget, IDC_FRAMEBUDGET_CYCLE_TAB_FPS) \
   E(kActionShowChromeLabs, IDC_SHOW_CHROME_LABS) \
   E(kActionSaveCreditCardForPage, IDC_SAVE_CREDIT_CARD_FOR_PAGE) \
   E(kActionSaveIbanForPage, IDC_SAVE_IBAN_FOR_PAGE) \
diff --git a/chrome/browser/ui/browser_actions.cc b/chrome/browser/ui/browser_actions.cc
index 0f7a326019..c192de81f8 100644
--- a/chrome/browser/ui/browser_actions.cc
+++ b/chrome/browser/ui/browser_actions.cc
@@ -22,6 +22,7 @@
 #include "build/branding_buildflags.h"
 #include "chrome/app/chrome_command_ids.h"
 #include "chrome/app/vector_icons/vector_icons.h"
+#include "chrome/browser/ui/framebudget/framebudget_tab_helper.h"
 #include "chrome/browser/browsing_data/browsing_data_important_sites_util.h"
 #include "chrome/browser/contextual_cueing/contextual_cueing_controller.h"
 #include "chrome/browser/contextual_cueing/features.h"
@@ -1610,6 +1611,32 @@ void BrowserActions::InitializeChromeMenuActions() {
 
   // TODO(crbug.com/435220196): Ideally this action would have
   // ChromeLabsCoordinator passed in as a dependency directly.
+  // FrameBudget: cycles the active tab's FPS, like Alt+Shift+F.
+  root_action_item_->AddChild(
+      actions::ActionItem::Builder(base::BindRepeating(
+                                       [](BrowserWindowInterface* bwi,
+                                          actions::ActionItem* item,
+                                          actions::ActionInvocationContext) {
+                                         tabs::TabInterface* tab =
+                                             bwi->GetActiveTabInterface();
+                                         if (auto* helper =
+                                                 tab ? FrameBudgetTabHelper::
+                                                           FromWebContents(
+                                                               tab->GetContents())
+                                                     : nullptr) {
+                                           helper->CycleTabOverride();
+                                         }
+                                       },
+                                       bwi))
+          .SetActionId(kActionFrameBudget)
+          .SetText(u"FrameBudget")
+          .SetTooltipText(u"이 탭의 FPS 바꾸기 (Alt+Shift+F)")
+          .SetImage(ui::ImageModel::FromVectorIcon(kSpeedIcon, ui::kColorIcon))
+          .SetProperty(actions::kActionItemPinnableKey,
+                       std::underlying_type_t<actions::ActionPinnableState>(
+                           actions::ActionPinnableState::kPinnable))
+          .Build());
+
   if (IsChromeLabsEnabled() && !web_app::AppBrowserController::IsWebApp(bwi)) {
     root_action_item_->AddChild(
         ChromeMenuAction(
