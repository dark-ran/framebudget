+  // Every setting, keyed by its pref name without the "framebudget." prefix.
+  void HandleExportSettings(const base::ListValue& args) {
+    base::DictValue out;
+    out.Set("version", 1);
+    for (const char* pref : kIntPrefs) {
+      out.Set(Key(pref), prefs()->GetInteger(pref));
+    }
+    for (const char* pref : kBoolPrefs) {
+      out.Set(Key(pref), prefs()->GetBoolean(pref));
+    }
+    for (const char* pref : kListPrefs) {
+      out.Set(Key(pref), prefs()->GetList(pref).Clone());
+    }
+    out.Set(Key(framebudget::kSitesPref),
+            prefs()->GetDict(framebudget::kSitesPref).Clone());
+    AllowJavascript();
+    CallJavascriptFunction(
+        "framebudget.onExport",
+        base::Value(base::WriteJsonWithOptions(
+                        out, base::JSONWriter::OPTIONS_PRETTY_PRINT)
+                        .value_or("{}")));
+  }
+
+  // Applies the keys it recognises and ignores the rest. Values are clamped
+  // and hosts normalised the same way as edits on this page.
+  void HandleImportSettings(const base::ListValue& args) {
+    std::optional<base::DictValue> in =
+        args.size() == 1 && args[0].is_string()
+            ? base::JSONReader::ReadDict(args[0].GetString(),
+                                         base::JSON_PARSE_CHROMIUM_EXTENSIONS)
+            : std::nullopt;
+    AllowJavascript();
+    if (!in) {
+      CallJavascriptFunction("framebudget.onImportResult",
+                             base::Value("JSON 파일을 읽지 못했습니다."));
+      return;
+    }
+    int applied = 0;
+    for (const char* pref : kIntPrefs) {
+      if (std::optional<int> v = in->FindInt(Key(pref))) {
+        prefs()->SetInteger(pref, framebudget::ClampFps(*v));
+        ++applied;
+      }
+    }
+    for (const char* pref : kBoolPrefs) {
+      if (std::optional<bool> v = in->FindBool(Key(pref))) {
+        prefs()->SetBoolean(pref, *v);
+        ++applied;
+      }
+    }
+    for (const char* pref : kListPrefs) {
+      if (const base::ListValue* list = in->FindList(Key(pref))) {
+        base::ListValue hosts;
+        for (const base::Value& v : *list) {
+          if (std::string host = v.is_string()
+                                     ? framebudget::NormalizeHost(v.GetString())
+                                     : std::string();
+              !host.empty() && !hosts.contains(host)) {
+            hosts.Append(std::move(host));
+          }
+        }
+        prefs()->SetList(pref, std::move(hosts));
+        ++applied;
+      }
+    }
+    if (const base::DictValue* sites =
+            in->FindDict(Key(framebudget::kSitesPref))) {
+      base::DictValue clean;
+      for (const auto [host, value] : *sites) {
+        const std::string normalized = framebudget::NormalizeHost(host);
+        if (std::optional<int> fps = value.GetIfInt(); fps && !normalized.empty()) {
+          clean.Set(normalized, framebudget::ClampFps(*fps));
+        }
+      }
+      prefs()->SetDict(framebudget::kSitesPref, std::move(clean));
+      ++applied;
+    }
+    CallJavascriptFunction(
+        "framebudget.onImportResult",
+        base::Value(applied ? "설정 " + base::NumberToString(applied) +
+                                  "개 항목을 불러왔습니다."
+                            : std::string("불러올 FrameBudget 설정이 없습니다.")));
+    SendState();
+  }
+
+  static std::string Key(std::string_view pref) {
+    return std::string(pref.substr(pref.find('.') + 1));
+  }
+
+  static constexpr const char* kIntPrefs[] = {
+      framebudget::kDefaultFpsPref, framebudget::kInactiveWindowFpsPref,
+      framebudget::kBatteryDefaultFpsPref};
+  static constexpr const char* kBoolPrefs[] = {
+      framebudget::kInputBoostPref, framebudget::kLiftDuringVideoPref};
+  static constexpr const char* kListPrefs[] = {
+      framebudget::kNoInputBoostSitesPref, framebudget::kLowResSitesPref};
+
   void SendState() {
     AllowJavascript();
     CallJavascriptFunction("framebudget.onState", base::Value(BuildState()));
