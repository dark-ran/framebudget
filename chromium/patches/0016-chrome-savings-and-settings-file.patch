+void FrameBudgetTabHelper::OnVisibilityChanged(content::Visibility visibility) {
+  AccountSavings(current_fps_);
+}
+
+void FrameBudgetTabHelper::AccountSavings(int fps) {
+  const base::TimeTicks now = base::TimeTicks::Now();
+  if (current_fps_ > 0 && !segment_start_.is_null()) {
+    float refresh = display::Screen::Get()
+                        ->GetDisplayNearestView(web_contents()->GetNativeView())
+                        .display_frequency();
+    if (refresh <= 0) {
+      refresh = 60;
+    }
+    const base::TimeDelta elapsed = now - segment_start_;
+    limited_time_ += elapsed;
+    saved_frames_ +=
+        elapsed.InSecondsF() * std::max(0.0f, refresh - current_fps_);
+  }
+  current_fps_ = fps;
+  // Hidden tabs do not draw at all, so only visible time counts.
+  segment_start_ =
+      web_contents()->GetVisibility() == content::Visibility::VISIBLE
+          ? now
+          : base::TimeTicks();
+}
+
+double FrameBudgetTabHelper::SavedFrames() {
+  AccountSavings(current_fps_);
+  return saved_frames_;
+}
+
+base::TimeDelta FrameBudgetTabHelper::LimitedTime() {
+  AccountSavings(current_fps_);
+  return limited_time_;
+}
