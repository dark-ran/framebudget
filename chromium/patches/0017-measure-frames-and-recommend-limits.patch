+void FrameSinkManagerImpl::GetFrameBudgetStats(
+    const FrameSinkId& frame_sink_id,
+    GetFrameBudgetStatsCallback callback) {
+  uint64_t drawn = 0;
+  uint64_t skipped = 0;
+  RecurseChildren(frame_sink_id, [this, &drawn, &skipped](const FrameSinkId& id) {
+    if (auto* support = GetFrameSinkForId(id)) {
+      drawn += support->frame_budget_drawn_frames();
+      skipped += support->frame_budget_skipped_frames();
+    }
+  });
+  std::move(callback).Run(drawn, skipped);
+}
