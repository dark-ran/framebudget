+
+// Tabs without a limit that keep drawing many frames get a suggestion.
+const RECOMMEND_FPS = 30;
+const RECOMMEND_SECONDS = 3;
+const history = new Map();
+function renderRecommendations(state) {
+  const now = performance.now();
+  const box = $('recommend');
+  box.replaceChildren();
+  for (const tab of state.tabs) {
+    const prev = history.get(tab.id);
+    const rate = prev && tab.drawnFrames >= prev.drawn ?
+        (tab.drawnFrames - prev.drawn) / ((now - prev.time) / 1000) : 0;
+    const busy = tab.fps === 0 && !tab.hasOverride && !tab.boosted && tab.host &&
+        rate >= RECOMMEND_FPS ? (prev ? prev.busy : 0) + 1 : 0;
+    history.set(tab.id, {drawn: tab.drawnFrames, time: now, busy});
+    if (busy < RECOMMEND_SECONDS) continue;
+    const p = el('p', `추천: ${tab.host}이(가) 제한 없이 초당 약 ${Math.round(rate)}프레임을 계속 그리고 있습니다. `);
+    p.className = 'recommend';
+    p.append(button('30FPS로 제한', () => chrome.send('setSiteRule', [tab.host, 30])),
+             ' ', button('15FPS로 제한', () => chrome.send('setSiteRule', [tab.host, 15])));
+    box.append(p);
+  }
 }
 
