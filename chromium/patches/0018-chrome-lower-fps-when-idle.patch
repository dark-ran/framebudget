 .../ui/framebudget/framebudget_policy.cc      | 44 +++++++++++++++----
 .../ui/framebudget/framebudget_policy.h       | 16 ++++++-
 .../ui/framebudget/framebudget_tab_helper.cc  | 30 ++++++++++++-
 .../ui/framebudget/framebudget_tab_helper.h   |  6 +++
 .../browser/ui/framebudget/framebudget_ui.cc  | 11 ++++-
 5 files changed, 95 insertions(+), 12 deletions(-)

diff --git a/chrome/browser/ui/framebudget/framebudget_policy.cc b/chrome/browser/ui/framebudget/framebudget_policy.cc
index 59c85259c3..5f9429e0f5 100644
--- a/chrome/browser/ui/framebudget/framebudget_policy.cc
+++ b/chrome/browser/ui/framebudget/framebudget_policy.cc
@@ -29,6 +29,9 @@ constexpr char kInactiveWindowFpsSwitch[] = "framebudget-inactive-window-fps";
 constexpr char kBatteryDefaultFpsSwitch[] = "framebudget-battery-default-fps";
 constexpr char kAssumeBatterySwitch[] = "framebudget-assume-battery";
 constexpr char kLiftDuringVideoSwitch[] = "framebudget-lift-during-video";
+constexpr char kIdleFpsSwitch[] = "framebudget-idle-fps";
+constexpr char kIdleSecondsSwitch[] = "framebudget-idle-seconds";
+constexpr int kDefaultIdleSeconds = 30;
 constexpr int kMaxFps = 240;
 
 // Returns `value` as an FPS, or nullopt if it is not a number.
@@ -90,6 +93,14 @@ CommandLineConfig::CommandLineConfig() {
   }
   assume_battery = command_line.HasSwitch(kAssumeBatterySwitch);
   lift_during_video = command_line.HasSwitch(kLiftDuringVideoSwitch);
+  if (command_line.HasSwitch(kIdleFpsSwitch)) {
+    idle_fps = ParseFps(command_line.GetSwitchValueASCII(kIdleFpsSwitch));
+  }
+  if (int seconds = 0; base::StringToInt(
+          command_line.GetSwitchValueASCII(kIdleSecondsSwitch), &seconds) &&
+      seconds > 0) {
+    idle_seconds = seconds;
+  }
 }
 
 CommandLineConfig::~CommandLineConfig() = default;
@@ -101,6 +112,7 @@ void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry) {
   registry->RegisterListPref(kNoInputBoostSitesPref);
   registry->RegisterListPref(kLowResSitesPref);
   registry->RegisterBooleanPref(kLiftDuringVideoPref, false);
+  registry->RegisterIntegerPref(kIdleFpsPref, 0);
   registry->RegisterIntegerPref(kInactiveWindowFpsPref, 0);
   registry->RegisterIntegerPref(kBatteryDefaultFpsPref, 0);
 }
@@ -168,7 +180,8 @@ Decision Decide(const PrefService& prefs,
                 std::string_view host,
                 std::optional<int> tab_override,
                 bool window_active,
-                bool video_playing) {
+                bool video_playing,
+                bool idle) {
   Decision decision = DecideIgnoringWindow(prefs, host, tab_override);
   if (decision.source == Source::kTabOverride) {
     return decision;
@@ -177,18 +190,31 @@ Decision Decide(const PrefService& prefs,
                         prefs.GetBoolean(kLiftDuringVideoPref))) {
     return {0, Source::kVideoPlaying, ""};
   }
-  if (window_active) {
-    return decision;
+  // These only ever lower the rate; the lowest one wins.
+  auto lower = [&decision](int fps, Source source) {
+    if (fps > 0 && (decision.fps == 0 || fps < decision.fps)) {
+      decision = {fps, source, ""};
+    }
+  };
+  const CommandLineConfig& command_line = GetCommandLineConfig();
+  if (!window_active) {
+    lower(command_line.inactive_window_fps.value_or(
+              ClampFps(prefs.GetInteger(kInactiveWindowFpsPref))),
+          Source::kInactiveWindow);
   }
-  const int inactive = GetCommandLineConfig().inactive_window_fps.value_or(
-      ClampFps(prefs.GetInteger(kInactiveWindowFpsPref)));
-  // Only ever lower the rate.
-  if (inactive > 0 && (decision.fps == 0 || inactive < decision.fps)) {
-    return {inactive, Source::kInactiveWindow, ""};
+  if (idle) {
+    lower(command_line.idle_fps.value_or(
+              ClampFps(prefs.GetInteger(kIdleFpsPref))),
+          Source::kIdle);
   }
   return decision;
 }
 
+base::TimeDelta IdleTimeout() {
+  return base::Seconds(
+      GetCommandLineConfig().idle_seconds.value_or(kDefaultIdleSeconds));
+}
+
 bool InputBoostAllowed(const PrefService& prefs, std::string_view host) {
   if (!prefs.GetBoolean(kInputBoostPref)) {
     return false;
@@ -238,6 +264,8 @@ std::string_view SourceId(Source source) {
       return "inactive-window";
     case Source::kVideoPlaying:
       return "video-playing";
+    case Source::kIdle:
+      return "idle";
   }
 }
 
