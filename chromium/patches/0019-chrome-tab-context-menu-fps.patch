diff --git a/chrome/browser/ui/framebudget/framebudget_tab_menu_model.cc b/chrome/browser/ui/framebudget/framebudget_tab_menu_model.cc
new file mode 100644
index 0000000000..d421fe63a6
--- /dev/null
+++ b/chrome/browser/ui/framebudget/framebudget_tab_menu_model.cc
@@ -0,0 +1,76 @@
+// Copyright 2026 WieHyunSeo
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/framebudget/framebudget_tab_menu_model.h"
+
+#include <array>
+#include <optional>
+
+#include "base/strings/string_number_conversions.h"
+#include "chrome/browser/ui/framebudget/framebudget_tab_helper.h"
+#include "content/public/browser/web_contents.h"
+
+namespace {
+
+// -1 follows the rules, 0 means no limit.
+constexpr std::array<int, 6> kChoices = {-1, 0, 60, 30, 15, 5};
+constexpr int kRadioGroup = 0;
+// Command ids must not collide with the rest of the tab menu: views looks
+// items up by id across the whole menu, so a shared id would check, label and
+// run the parent's command instead (e.g. 1 is Reload). Other tab submenus use
+// 1000-1999.
+constexpr int kFirstCommandId = 2101;
+
+// The choice for `command_id`, or nullopt if it is not one of ours.
+std::optional<int> ChoiceFor(int command_id) {
+  const int index = command_id - kFirstCommandId;
+  if (index < 0 || index >= static_cast<int>(kChoices.size())) {
+    return std::nullopt;
+  }
+  return kChoices[index];
+}
+
+std::u16string Label(int fps) {
+  if (fps < 0) {
+    return u"규칙 따름";
+  }
+  return fps == 0 ? u"제한 없음" : base::NumberToString16(fps) + u" FPS";
+}
+
+}  // namespace
+
+FrameBudgetTabMenuModel::FrameBudgetTabMenuModel(
+    content::WebContents* web_contents)
+    : ui::SimpleMenuModel(this), web_contents_(web_contents->GetWeakPtr()) {
+  for (size_t i = 0; i < kChoices.size(); ++i) {
+    AddRadioItem(kFirstCommandId + static_cast<int>(i), Label(kChoices[i]),
+                 kRadioGroup);
+  }
+}
+
+FrameBudgetTabMenuModel::~FrameBudgetTabMenuModel() = default;
+
+bool FrameBudgetTabMenuModel::IsCommandIdChecked(int command_id) const {
+  FrameBudgetTabHelper* helper =
+      web_contents_ ? FrameBudgetTabHelper::FromWebContents(web_contents_.get())
+                    : nullptr;
+  const std::optional<int> choice = ChoiceFor(command_id);
+  if (!helper || !choice) {
+    return false;
+  }
+  const std::optional<int> fps = helper->tab_override();
+  return *choice < 0 ? !fps.has_value() : fps == *choice;
+}
+
+void FrameBudgetTabMenuModel::ExecuteCommand(int command_id, int event_flags) {
+  if (FrameBudgetTabHelper* helper =
+          web_contents_
+              ? FrameBudgetTabHelper::FromWebContents(web_contents_.get())
+              : nullptr) {
+    if (const std::optional<int> choice = ChoiceFor(command_id)) {
+      helper->SetTabOverride(*choice < 0 ? std::nullopt
+                                         : std::optional<int>(*choice));
+    }
+  }
+}
