+++ b/chrome/browser/ui/framebudget/framebudget_tab_menu_model.h
@@ -0,0 +1,33 @@
+// Copyright 2026 WieHyunSeo
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_FRAMEBUDGET_FRAMEBUDGET_TAB_MENU_MODEL_H_
+#define CHROME_BROWSER_UI_FRAMEBUDGET_FRAMEBUDGET_TAB_MENU_MODEL_H_
+
+#include "base/memory/weak_ptr.h"
+#include "ui/menus/simple_menu_model.h"
+
+namespace content {
+class WebContents;
+}
+
+// "FrameBudget FPS" submenu of the tab context menu: picks the tab's own FPS,
+// like Alt+Shift+F or the "이 탭만" column on chrome://framebudget.
+class FrameBudgetTabMenuModel : public ui::SimpleMenuModel,
+                                public ui::SimpleMenuModel::Delegate {
+ public:
+  explicit FrameBudgetTabMenuModel(content::WebContents* web_contents);
+  FrameBudgetTabMenuModel(const FrameBudgetTabMenuModel&) = delete;
+  FrameBudgetTabMenuModel& operator=(const FrameBudgetTabMenuModel&) = delete;
+  ~FrameBudgetTabMenuModel() override;
+
+  // ui::SimpleMenuModel::Delegate:
+  bool IsCommandIdChecked(int command_id) const override;
+  void ExecuteCommand(int command_id, int event_flags) override;
+
+ private:
+  base::WeakPtr<content::WebContents> web_contents_;
+};
+
+#endif  // CHROME_BROWSER_UI_FRAMEBUDGET_FRAMEBUDGET_TAB_MENU_MODEL_H_
