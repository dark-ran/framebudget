   pref_change_registrar_.Init(prefs());
   for (const char* pref :
@@ -243,6 +254,7 @@ void FrameBudgetTabHelper::OnIdle() {
 void FrameBudgetTabHelper::WebContentsDestroyed() {
   boost_timer_.Stop();
   idle_timer_.Stop();
