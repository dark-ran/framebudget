@@ -318,6 +330,32 @@ void FrameBudgetTabHelper::MediaStoppedPlaying(
   }
 }
 
+namespace {
+
+// Per-profile site totals, kept on the BrowserContext so that an incognito
+// profile has its own.
+struct SiteTotalsData : public base::SupportsUserData::Data {
+  static SiteTotalsData* Get(content::BrowserContext* context) {
+    static const char kKey[] = "FrameBudgetSiteTotals";
+    auto* data = static_cast<SiteTotalsData*>(context->GetUserData(kKey));
+    if (!data) {
+      auto owned = std::make_unique<SiteTotalsData>();
+      data = owned.get();
+      context->SetUserData(kKey, std::move(owned));
+    }
+    return data;
+  }
+  std::map<std::string, FrameBudgetTabHelper::SiteTotals> totals;
+};
+
+}  // namespace
+
+// static
+const std::map<std::string, FrameBudgetTabHelper::SiteTotals>&
+FrameBudgetTabHelper::GetSiteTotals(content::BrowserContext* context) {
+  return SiteTotalsData::Get(context)->totals;
+}
+
 void FrameBudgetTabHelper::RequestStats() {
   content::RenderWidgetHost* widget =
       web_contents()->GetPrimaryMainFrame()->GetRenderWidgetHost();
@@ -327,12 +365,29 @@ void FrameBudgetTabHelper::RequestStats() {
   content::GetFrameBudgetStats(
       widget->GetFrameSinkId(),
       base::BindOnce(&FrameBudgetTabHelper::OnStats,
-                     weak_factory_.GetWeakPtr()));
+                     weak_factory_.GetWeakPtr(), widget->GetFrameSinkId(),
+                     host()));
 }
 
-// Counts belong to the page's frame sink, so a new page starts again at 0.
-void FrameBudgetTabHelper::OnStats(uint64_t drawn_frames,
+void FrameBudgetTabHelper::OnStats(viz::FrameSinkId frame_sink_id,
+                                   std::string host,
+                                   uint64_t drawn_frames,
                                    uint64_t skipped_frames) {
+  if (frame_sink_id != stats_frame_sink_id_) {
+    stats_frame_sink_id_ = frame_sink_id;
+    drawn_frames_ = 0;
+    skipped_frames_ = 0;
+  }
+  // Replies can arrive out of order; counts only ever grow.
+  if (drawn_frames < drawn_frames_ || skipped_frames < skipped_frames_) {
+    return;
+  }
+  if (!host.empty()) {
+    SiteTotals& site =
+        SiteTotalsData::Get(web_contents()->GetBrowserContext())->totals[host];
+    site.drawn += drawn_frames - drawn_frames_;
+    site.skipped += skipped_frames - skipped_frames_;
+  }
   drawn_frames_ = drawn_frames;
   skipped_frames_ = skipped_frames;
 }
