FrameBudget 간격이 에너지 세이버 같은 다른 제한과 정확히 같으면 상한 판정이
꺼져 vsync 반올림으로 돌아갔다(100Hz에서 30FPS가 33FPS). 같을 때도 상한으로
본다.
---
 .../viz/service/frame_sinks/frame_sink_manager_impl.cc       | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/components/viz/service/frame_sinks/frame_sink_manager_impl.cc b/components/viz/service/frame_sinks/frame_sink_manager_impl.cc
index abb9a446a0..2cbfc484c8 100644
--- a/components/viz/service/frame_sinks/frame_sink_manager_impl.cc
+++ b/components/viz/service/frame_sinks/frame_sink_manager_impl.cc
@@ -1375,8 +1375,9 @@ void FrameSinkManagerImpl::ApplyThrottlingRules(
                                           ? throttle_interval_
                                           : global_throttle;
       support->SetThrottleInterval(std::max(budget, current));
-      // The budget is a cap only when it, not another throttle, sets the rate.
-      support->SetThrottleIntervalIsCap(budget > current);
+      // The budget is a cap whenever it sets the rate, including a tie with
+      // another throttle; otherwise viz would round it to the nearest vsync.
+      support->SetThrottleIntervalIsCap(budget >= current);
     }
   }
 
