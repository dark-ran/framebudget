HostFrameSinkManager는 Viz(GPU 프로세스)와 다시 연결될 때 프레임 싱크와
계층만 다시 등록하고 FrameBudget 간격은 보내지 않았다. 브라우저의 탭 헬퍼는
이미 적용했다고 보고 다시 보내지 않으므로, GPU 프로세스를 종료하면 15FPS
규칙 탭이 60FPS로 돌았다. 적용 중인 간격을 호스트에 기억해 두었다가
재연결 때 다시 보내고, 프레임 싱크를 무효화하면 지운다.
---
 components/viz/host/host_frame_sink_manager.cc | 14 ++++++++++++++
 components/viz/host/host_frame_sink_manager.h  |  3 +++
 2 files changed, 17 insertions(+)

diff --git a/components/viz/host/host_frame_sink_manager.cc b/components/viz/host/host_frame_sink_manager.cc
index 4d85305bc1..f2f03dc0d2 100644
--- a/components/viz/host/host_frame_sink_manager.cc
+++ b/components/viz/host/host_frame_sink_manager.cc
@@ -146,6 +146,8 @@ void HostFrameSinkManager::InvalidateFrameSinkId(
   // Viz drops its own request as part of invalidation, so there is no need to
   // send CancelNonEmptyFrameNotification() here.
   non_empty_frame_callbacks_.erase(frame_sink_id);
+  // Viz drops the FrameBudget interval on invalidation as well.
+  frame_budget_intervals_.erase(frame_sink_id);
 
   FrameSinkData& data = frame_sink_data_map_[frame_sink_id];
   CHECK(data.IsFrameSinkRegistered());
@@ -456,6 +458,12 @@ void HostFrameSinkManager::StopThrottlingAllFrameSinks() {
 void HostFrameSinkManager::SetFrameBudgetInterval(
     const FrameSinkId& frame_sink_id,
     base::TimeDelta interval) {
+  // Remembered so that a restarted Viz gets it again.
+  if (interval.is_positive()) {
+    frame_budget_intervals_[frame_sink_id] = interval;
+  } else {
+    frame_budget_intervals_.erase(frame_sink_id);
+  }
   frame_sink_manager_->SetFrameBudgetInterval(frame_sink_id, interval);
 }
 
@@ -543,6 +551,12 @@ void HostFrameSinkManager::RegisterAfterConnectionLoss() {
     }
   }
 
+  // FrameBudget: a new Viz instance knows no intervals, and the browser side
+  // believes they are already applied, so send them again.
+  for (const auto& [frame_sink_id, interval] : frame_budget_intervals_) {
+    frame_sink_manager_->SetFrameBudgetInterval(frame_sink_id, interval);
+  }
+
   // Re-arm pending non-empty frame notifications, since the new Viz instance
   // has no knowledge of them. This happens before any CompositorFrameSink is
   // recreated, so the client still cannot paint before Viz is armed.
diff --git a/components/viz/host/host_frame_sink_manager.h b/components/viz/host/host_frame_sink_manager.h
index 776fe0e53b..f433d17018 100644
--- a/components/viz/host/host_frame_sink_manager.h
+++ b/components/viz/host/host_frame_sink_manager.h
@@ -477,6 +477,9 @@ class VIZ_HOST_EXPORT HostFrameSinkManager
   std::unordered_map<FrameSinkId, FrameSinkData, FrameSinkIdHash>
       frame_sink_data_map_;
 
+  // FrameBudget intervals that are in effect, re-sent after Viz restarts.
+  base::flat_map<FrameSinkId, base::TimeDelta> frame_budget_intervals_;
+
   base::flat_map<FrameSinkId, base::ScopedClosureRunner>
       frame_sink_invalidate_callbacks_;
 
